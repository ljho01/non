{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node", "electron"]
  },
  "include": ["electron"],
  "exclude": ["electron/**/*.test.ts", "src/**/__test__/**"]
}
