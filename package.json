{
  "name": "non",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first notes, PDF, and AI desktop workspace",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "bun run build:electron && concurrently --kill-others --success first \"bun run dev:ui\" \"bun run dev:desktop\"",
    "dev:desktop": "wait-on http://127.0.0.1:1420 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:1420 electron .",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1 --open /scripts/preview-index.html",
    "build:ui": "tsc -p tsconfig.json && vite build",
    "build:electron": "bun scripts/build-electron.ts",
    "build": "bun run build:ui && bun run build:electron && electron-builder --mac dir",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.agent.json && tsc -p tsconfig.electron.json && tsc -p tsconfig.test.json",
    "test": "bun run build:electron && bun test agent electron src"
  },
  "devDependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@excalidraw/excalidraw": "0.18.1",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@jsep-plugin/object": "^1.2.2",
    "@jsep-plugin/regex": "^1.0.4",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/ai": "^0.54.0",
    "@tanstack/ai-client": "^0.31.1",
    "@tanstack/ai-react": "^0.24.1",
